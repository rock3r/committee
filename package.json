{
  "name": "committee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node --test test/*.test.ts",
    "test:web": "node --test web/",
    "lint": "eslint .",
    "typecheck": "tsc --pretty false",
    "test:python": "python3 -m unittest discover -s test -p '*_test.py'",
    "build:reader": "node scripts/build-reader.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:web && npm run test:python && npm run build:reader && npm run check:release",
    "demo": "node scripts/demo.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.132.0"
  },
  "license": "Apache-2.0"
}
